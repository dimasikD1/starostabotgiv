# ==============================================================
# Telegram-бот «Староста 24» — Переменные окружения
# ==============================================================

# Токен бота от @BotFather (ОБЯЗАТЕЛЬНО)
# Скопируйте его из диалога с @BotFather в Telegram:
TELEGRAM_BOT_TOKEN="123456789:AAE_вашего_бота_токен_здесь"

# Путь к постоянному хранилищу данных db.json:
# В облаке Amvera используется том /data
# Для локальной разработки можно оставить пустым или ./data
DATA_DIR="/data"

# Необязательный порт для Health-Check сервера (в Amvera для типа 'Приложение')
# PORT=80
