TELEGRAM_BOT_TOKEN=

# Основной источник расписания РУК
SCHEDULE_SITE_URL=https://schedule.ruc.su/
# Если укажешь свой API-адаптер, он имеет приоритет над SCHEDULE_SITE_URL
