TELEGRAM_BOT_TOKEN=

# Публичный HTTPS-адрес Mini App (кнопка «Открыть кабинет» в боте)
WEBAPP_URL=

# Часовой пояс расписания и посещаемости
TIME_ZONE=Europe/Moscow

# Каталог данных и интервал резервного копирования (мс)
DATA_DIR=/data
DB_BACKUP_INTERVAL_MS=60000

# Основной источник расписания РУК
SCHEDULE_SITE_URL=https://schedule.ruc.su/
# Если укажешь свой API-адаптер, он имеет приоритет над SCHEDULE_SITE_URL
SCHEDULE_API_URL=

# Необязательно: можно ограничить поиск конкретным филиалом/годом
SCHEDULE_BRANCH=
SCHEDULE_KIT=

SCHEDULE_DAYS=7
SCHEDULE_TIMEOUT=20000
# true — запасной режим для нового сайта, если старый источник недоступен
SCHEDULE_FALLBACK_NEW=false

SUBSCRIPTION_RUB=199
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
YOOKASSA_RETURN_URL=https://YOUR-AMVERA-DOMAIN/payment-return

# Числовой Telegram user ID владельца: для него бот всегда бесплатный.
OWNER_TELEGRAM_ID=
