{
  "name": "starosta-bot",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Telegram-бот старосты с интеграцией расписания и опросов.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node bot-amvera/index.mjs",
    "dev": "node --watch bot-amvera/index.mjs",
    "check": "node --check bot-amvera/index.mjs && node --check bot-amvera/schedule/ruc.mjs",
    "typecheck": "tsc --noEmit",
    "test": "npm run test:typescript && node --test bot-amvera/test/parser.test.mjs bot-amvera/test/schedule-api.test.mjs",
    "test:typescript": "tsc -p tsconfig.test.json && node --test bot-amvera/test/schedule-ruc-typescript.test.mjs"
  },
  "dependencies": {
    "cheerio": "^1.0.0",
    "telegraf": "^4.16.3"
  },
  "devDependencies": {
    "@types/node": "^20.19.0",
    "typescript": "^5.9.3"
  }
}
